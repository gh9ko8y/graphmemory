# ===== 数据库（docker compose 会读取这些变量）=====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphmemory_dev

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=graphmemory
POSTGRES_PASSWORD=graphmemory_dev
POSTGRES_DB=graphmemory

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=graphmemory_dev

# ===== Embedding（OpenAI 兼容接口；示例用智谱 embedding-3）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEFAULT_EMBEDDING_MODEL=embedding-3

# ===== 事实抽取 LLM（OpenAI 兼容接口；示例用 DeepSeek）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-chat

# ===== 应用 =====
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info
# 非空时 /api 请求需带 X-API-Key 头
API_KEY=
# 行为账本缓存目录（可选）
ACTION_LEDGER_DIR=/tmp/graphmemory-action-ledger
